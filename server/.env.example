# Server
PORT=4000
NODE_ENV=production

# JWT — generează cu: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SCHIMBA_CU_UN_SECRET_LUNG_SI_RANDOM

# Token pentru autentificarea update-agent pe mini PC-uri
UPDATE_AGENT_TOKEN=SCHIMBA_CU_UN_TOKEN_RANDOM

# SMTP pentru trimiterea email-urilor (reset parolă, rapoarte)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=parola_smtp
SMTP_FROM=noreply@example.com

# URL aplicație (folosit în email-uri)
APP_URL=https://displayiq.funkymedia.ro

# Cont admin creat automat la primul start (opțional dacă există deja)
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=parola_admin_puternica

# Anthropic API (pentru funcțiile AI)
ANTHROPIC_API_KEY=sk-ant-...

# Director uploads (opțional, default: uploads/ lângă server)
# UPLOADS_DIR=/path/to/uploads
